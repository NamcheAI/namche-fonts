{
  "name": "@namche/namche-shadow",
  "version": "0.2.1",
  "description": "Namche Shadow Sans, Mono, and Pixel for Next.js and framework-agnostic CSS.",
  "main": "./dist/font.js",
  "type": "module",
  "module": "./dist/font.js",
  "types": "./font.d.ts",
  "scripts": {
    "build:css": "node ../../scripts/build-webfont-css.mjs",
    "check:css": "node ../../scripts/build-webfont-css.mjs --check",
    "version": "changeset version && pnpm run build:css",
    "release": "changeset publish"
  },
  "bugs": {
    "url": "https://github.com/NamcheAI/namche-shadow-font/issues"
  },
  "homepage": "https://github.com/NamcheAI/namche-shadow-font",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NamcheAI/namche-shadow-font.git",
    "directory": "packages/next"
  },
  "keywords": [
    "namche shadow",
    "namche shadow mono",
    "namche shadow pixel",
    "next.js font",
    "geist derivative"
  ],
  "files": [
    "dist/**/*",
    "font.d.ts",
    "font/**/*",
    "fonts.css",
    "sans.css",
    "mono.css",
    "pixel.css",
    "fonts.cdn.css",
    "sans.cdn.css",
    "mono.cdn.css",
    "pixel.cdn.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./font": {
      "types": "./dist/font.d.ts",
      "default": "./dist/font.js"
    },
    "./font/mono": {
      "types": "./dist/mono.d.ts",
      "default": "./dist/mono.js"
    },
    "./font/mono-non-variable": {
      "types": "./dist/mono-non-variable.d.ts",
      "default": "./dist/mono-non-variable.js"
    },
    "./font/sans": {
      "types": "./dist/sans.d.ts",
      "default": "./dist/sans.js"
    },
    "./font/sans-non-variable": {
      "types": "./dist/sans-non-variable.d.ts",
      "default": "./dist/sans-non-variable.js"
    },
    "./font/pixel": {
      "types": "./dist/pixel.d.ts",
      "default": "./dist/pixel.js"
    },
    "./fonts.css": "./fonts.css",
    "./sans.css": "./sans.css",
    "./mono.css": "./mono.css",
    "./pixel.css": "./pixel.css",
    "./fonts.cdn.css": "./fonts.cdn.css",
    "./sans.cdn.css": "./sans.cdn.css",
    "./mono.cdn.css": "./mono.cdn.css",
    "./pixel.cdn.css": "./pixel.cdn.css",
    "./package.json": "./package.json"
  },
  "license": "OFL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=13.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "next": "16.3.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
